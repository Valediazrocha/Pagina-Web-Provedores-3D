CREATE TABLE proveedor (
    id_proveedor   INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre         TEXT    NOT NULL UNIQUE,
    slug           TEXT    NOT NULL UNIQUE,          -- 'centro3d', 'bambulab-colombia', 'zuluprints'
    url_base       TEXT    NOT NULL,
    plataforma     TEXT    NOT NULL CHECK (plataforma IN ('woocommerce','shopify','html')),
    direccion      TEXT,
    ciudad         TEXT    NOT NULL DEFAULT 'Bogotá D.C.' CHECK (ciudad = 'Bogotá D.C.'),  -- alcance: solo Bogotá
    localidad      TEXT,
    lat            REAL,                             -- aproximada (ver README)
    lng            REAL,
    es_online      INTEGER NOT NULL DEFAULT 0 CHECK (es_online IN (0,1)),  -- 1 = sin local físico verificado
    valoracion     REAL    CHECK (valoracion IS NULL OR (valoracion BETWEEN 0 AND 5)), -- NULL = sin dato real
    activo         INTEGER NOT NULL DEFAULT 1 CHECK (activo IN (0,1))
);
