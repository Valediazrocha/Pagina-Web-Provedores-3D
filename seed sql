CREATE TABLE producto (
    id_producto    INTEGER PRIMARY KEY AUTOINCREMENT,
    id_proveedor   INTEGER NOT NULL REFERENCES proveedor(id_proveedor) ON DELETE CASCADE,
    id_marca       INTEGER REFERENCES marca(id_marca),
    id_material    INTEGER REFERENCES material(id_material),
    nombre         TEXT    NOT NULL,
    sku            TEXT,
    color          TEXT,
    peso_kg        REAL    NOT NULL DEFAULT 1.0 CHECK (peso_kg > 0),
    peso_estimado  INTEGER NOT NULL DEFAULT 0 CHECK (peso_estimado IN (0,1)), -- 1 = el sitio no lo indica
    diametro_mm    REAL    NOT NULL DEFAULT 1.75,
    url_producto   TEXT    NOT NULL,
    imagen_url     TEXT,
    precio_actual  INTEGER NOT NULL CHECK (precio_actual > 0),   -- COP, IVA incluido
    precio_lista   INTEGER,                                      -- precio sin descuento (si aplica)
    stock_estado   TEXT    NOT NULL DEFAULT 'desconocido'
                   CHECK (stock_estado IN ('en_stock','agotado','desconocido')),
    stock_unidades INTEGER,
    fuente_fecha   TEXT    NOT NULL,                  -- ISO-8601 de la última lectura
    activo         INTEGER NOT NULL DEFAULT 1 CHECK (activo IN (0,1)),
    UNIQUE (id_proveedor, url_producto, color)
);
