CREATE TABLE scrape_run (
    id_run            INTEGER PRIMARY KEY AUTOINCREMENT,
    id_proveedor      INTEGER REFERENCES proveedor(id_proveedor),
    inicio            TEXT NOT NULL,
    fin               TEXT,
    estado            TEXT NOT NULL CHECK (estado IN ('ok','error','parcial')),
    productos_leidos  INTEGER DEFAULT 0,
    productos_nuevos  INTEGER DEFAULT 0,
    precios_cambiados INTEGER DEFAULT 0,
    mensaje           TEXT
);
CREATE INDEX ix_producto_material  ON producto(id_material);
CREATE INDEX ix_producto_proveedor ON producto(id_proveedor);
CREATE INDEX ix_producto_precio    ON producto(precio_actual);
CREATE INDEX ix_producto_color     ON producto(color);
CREATE INDEX ix_hist_producto_fecha ON precio_historico(id_producto, fecha);
CREATE VIEW v_ofertas AS
SELECT  p.id_producto,
        p.nombre,
        p.sku,
        p.color,
        p.peso_kg,
        p.peso_estimado,
        p.diametro_mm,
        p.url_producto,
        p.imagen_url,
        p.precio_actual,
        p.precio_lista,
        CAST(ROUND(p.precio_actual / p.peso_kg) AS INTEGER) AS precio_por_kg,
        p.stock_estado,
        p.stock_unidades,
        p.fuente_fecha,
        m.nombre      AS material,
        m.familia     AS familia_material,
        mc.nombre     AS marca,
        pr.id_proveedor,
        pr.nombre     AS proveedor,
        pr.slug       AS proveedor_slug,
        pr.direccion  AS proveedor_direccion,
        pr.localidad  AS proveedor_localidad,
        pr.lat        AS proveedor_lat,
        pr.lng        AS proveedor_lng,
        pr.es_online  AS proveedor_online,
        pr.valoracion AS proveedor_valoracion
FROM producto p
JOIN proveedor pr ON pr.id_proveedor = p.id_proveedor AND pr.activo = 1 AND pr.ciudad = 'Bogotá D.C.'
LEFT JOIN material m  ON m.id_material = p.id_material
LEFT JOIN marca    mc ON mc.id_marca   = p.id_marca
WHERE p.activo = 1;
CREATE VIEW v_mejor_precio AS
SELECT material, color, MIN(precio_por_kg) AS mejor_precio_kg, COUNT(*) AS n_ofertas
FROM v_ofertas
WHERE stock_estado <> 'agotado'
GROUP BY material, color;
